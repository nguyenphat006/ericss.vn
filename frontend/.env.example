# Sao chép thành frontend/.env.local. KHÔNG commit file .env.local.

# CMS (backend/, Django + Wagtail). Bỏ trống = dùng dữ liệu mock trong src/data.
# Local: chạy backend bằng `python -m uv run poe dev` (cổng 9100).
CMS_API_URL=
# CMS_API_URL=http://127.0.0.1:9100/api/v1
# Bí mật chung với CMS (CMS_SHARED_SECRET bên backend) để CMS gọi /api/revalidate khi xuất bản
CMS_REVALIDATE_SECRET=
