# Sao chép thành backend/.env để chạy local. KHÔNG commit file .env.
# Production truyền các biến này qua Docker Compose (env_file), xem docs/adr/0006.

# --- Django
# Dev có khoá mặc định; production BẮT BUỘC, >= 50 ký tự:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database: bỏ trống ở local (SQLite db.sqlite3). CI / production: Postgres
# DATABASE_URL=postgres://portfolio:password@localhost:5432/portfolio_cms

# --- Wagtail
WAGTAILADMIN_BASE_URL=http://127.0.0.1:9100

# --- Webhook làm mới cache frontend khi xuất bản. CMS_SHARED_SECRET phải trùng
# CMS_REVALIDATE_SECRET bên frontend/.env.local. Trống = không gọi (web tự làm mới sau tối đa 1 giờ)
CMS_SHARED_SECRET=
FRONTEND_REVALIDATE_URL=http://localhost:4100/api/revalidate

# --- Dịch máy (wagtail-localize + Google Cloud Translation). Bỏ trống = dịch tay
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# --- Email (production). Local ghi email ra backend/tmp/emails
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Site CMS <no-reply@example.com>

LOG_LEVEL=INFO
